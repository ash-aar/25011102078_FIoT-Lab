  {
    "id": "node_process_sensor",
    "type": "function",
    "z": "tab_env_intel",
    "name": "PROCESS - BME280 Sensor Data",
    "func": "var payload = msg.payload;\nif (typeof payload === 'string') {\n    try {\n        payload = JSON.parse(payload);\n    } catch(e) {\n        node.error('JSON parse error: ' + e.message);\n        return null;\n    }\n}\n\nflow.set('bme_temp', parseFloat(payload.temperature) || 0);\nflow.set('bme_hum', parseFloat(payload.humidity) || 0);\nflow.set('bme_press', parseFloat(payload.pressure) || 0);\nflow.set('bme_updated', new Date().toLocaleTimeString());\n\nmsg.payload = {\n    temperature: flow.get('bme_temp'),\n    humidity: flow.get('bme_hum'),\n    pressure: flow.get('bme_press'),\n    timestamp: flow.get('bme_updated')\n};\n\nreturn [msg, msg, msg, msg, msg];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 250,
    "y": 380,
    "wires": [
      [
        "node_build_dashboard"
      ],
      [
        "node_debug_processed"
      ],
      [
        "node_extract_temp"
      ],
      [
        "node_extract_hum"
      ],
      [
        "node_extract_press"
      ]
    ]
  },
