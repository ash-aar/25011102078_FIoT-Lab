  {
    "id": "node_build_dashboard",
    "type": "function",
    "z": "tab_env_intel",
    "name": "BUILD - Dashboard Data",
    "func": "var bmeTemp = flow.get('bme_temp');\nvar bmeHum = flow.get('bme_hum');\nvar bmePress = flow.get('bme_press');\nvar bmeUpdated = flow.get('bme_updated') || 'Waiting for data';\n\nvar weatherTemp = flow.get('weather_temp');\nvar weatherHum = flow.get('weather_hum');\nvar weatherDesc = flow.get('weather_desc') || 'Waiting for data';\nvar weatherUpdated = flow.get('weather_updated') || 'Waiting for data';\n\nvar tempDiff = '--';\nvar comparisonStatus = 'Waiting for data';\nvar advisory = 'Waiting for data';\n\nif (bmeTemp !== undefined && weatherTemp !== undefined) {\n    var diff = (bmeTemp - weatherTemp).toFixed(1);\n    tempDiff = (diff > 0 ? '+' : '') + diff + ' \u00b0C';\n    \n    if (bmeTemp > weatherTemp + 2) {\n        comparisonStatus = 'Indoor significantly warmer than outdoor';\n        advisory = 'Indoor heat trap detected. Enable cross-ventilation or air conditioning to prevent discomfort.';\n    } else if (bmeTemp < weatherTemp - 2) {\n        comparisonStatus = 'Indoor cooler than outdoor ambient';\n        advisory = 'Indoor climate retention optimal. Keep windows closed during peak noon hours.';\n    } else {\n        comparisonStatus = 'Thermal equilibrium reached';\n        advisory = 'Classroom thermal conditions align comfortably with ambient micro-climate.';\n    }\n}\n\nmsg.payload = {\n    sensorStatus: bmeTemp !== undefined ? 'ONLINE' : 'Waiting for data',\n    weatherStatus: weatherTemp !== undefined ? 'CONNECTED' : 'Waiting for data',\n    sensorUpdated: bmeUpdated,\n    weatherUpdated: weatherUpdated,\n    bmeTemp: bmeTemp !== undefined ? bmeTemp.toFixed(1) : '--',\n    bmeHum: bmeHum !== undefined ? bmeHum.toFixed(1) : '--',\n    bmePress: bmePress !== undefined ? bmePress.toFixed(1) : '--',\n    weatherTemp: weatherTemp !== undefined ? weatherTemp.toFixed(1) : '--',\n    weatherHum: weatherHum !== undefined ? weatherHum.toFixed(1) : '--',\n    tempDiff: tempDiff,\n    comparisonStatus: comparisonStatus,\n    advisory: advisory\n};\n\nreturn msg;",
    "outputs": 1,
    "x": 690,
    "y": 70,
    "wires": [
      [
        "node_ui_dashboard"
      ]
    ]
  },
  {
    "id": "node_ui_dashboard",
    "type": "ui_template",
    "z": "tab_env_intel",
    "name": "UI - Environmental Intelligence",
    "group": "ui_group_main",
    "order": 4,
    "width": "18",
    "height": "12",
    "format": "<style>\n  .ei-container { background: #0b111e; color: #e2e8f0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; padding: 24px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }\n  .ei-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; padding-bottom: 16px; margin-bottom: 24px; }\n  .ei-title { font-size: 24px; font-weight: 700; color: #f8fafc; letter-spacing: -0.5px; display: flex; align-items: center; gap: 10px; }\n  .badge { background: #0369a1; color: #38bdf8; font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.5px; }\n  .ei-meta { display: flex; gap: 20px; font-size: 12px; color: #94a3b8; }\n  .status-pill { background: #1e293b; padding: 4px 12px; border-radius: 8px; border: 1px solid #334155; }\n  .status-pill b { color: #38bdf8; }\n  .ei-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 20px; }\n  .ei-card { background: #131d2e; border: 1px solid #1e293b; border-radius: 12px; padding: 18px; transition: transform 0.2s ease, border-color 0.2s ease; }\n  .ei-card:hover { border-color: #38bdf8; }\n  .card-label { font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 4px; }\n  .card-sub { font-size: 14px; font-weight: 600; color: #94a3b8; margin-bottom: 12px; }\n  .card-value { font-size: 32px; font-weight: 700; color: #f8fafc; display: flex; align-items: baseline; gap: 6px; }\n  .card-unit { font-size: 16px; color: #64748b; font-weight: 500; }\n  .status-tag { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 6px; background: #1e293b; color: #38bdf8; float: right; }\n  .progress-track { background: #1e293b; height: 6px; border-radius: 3px; margin-top: 14px; overflow: hidden; }\n  .progress-fill { background: linear-gradient(90deg, #0284c7, #38bdf8); height: 100%; border-radius: 3px; }\n  .ei-footer-grid { display: grid; grid-template-columns: 1fr 1fr 1.2fr; gap: 16px; }\n  .advisory-box { background: #101c30; border-left: 4px solid #38bdf8; border-radius: 12px; padding: 18px; }\n  .advisory-title { font-size: 14px; font-weight: 700; color: #38bdf8; text-transform: uppercase; margin-bottom: 8px; }\n  .advisory-text { font-size: 13px; line-height: 1.6; color: #cbd5e1; }\n</style>\n\n<div class=\"ei-container\">\n  <div class=\"ei-header\">\n    <div>\n      <div class=\"ei-title\">\n        <span>Environmental Intelligence</span>\n        <span class=\"badge\">LIVE TELEMETRY</span>\n      </div>\n      <div style=\"font-size: 13px; color: #64748b; margin-top: 4px;\">Classroom IoT Monitoring &bull; Shiv Nadar University Chennai</div>\n    </div>\n    <div class=\"ei-meta\">\n      <div class=\"status-pill\">SENSOR: <b>{{msg.payload.sensorStatus}}</b></div>\n      <div class=\"status-pill\">WEATHER API: <b>{{msg.payload.weatherStatus}}</b></div>\n      <div class=\"status-pill\">UPDATED: <b>{{msg.payload.sensorUpdated}}</b></div>\n    </div>\n  </div>\n\n  <div class=\"ei-grid\">\n    <div class=\"ei-card\">\n      <span class=\"status-tag\">{{msg.payload.sensorStatus}}</span>\n      <div class=\"card-label\">AMBIENT THERMAL</div>\n      <div class=\"card-sub\">Temperature</div>\n      <div class=\"card-value\">{{msg.payload.bmeTemp}}<span class=\"card-unit\">&deg;C</span></div>\n      <div class=\"progress-track\"><div class=\"progress-fill\" style=\"width: 60%;\"></div></div>\n      <div style=\"display:flex; justify-content:space-between; font-size:10px; color:#64748b; margin-top:4px;\"><span>0&deg;C</span><span>CLASSROOM SENSOR</span><span>50&deg;C</span></div>\n    </div>\n\n    <div class=\"ei-card\">\n      <span class=\"status-tag\">{{msg.payload.sensorStatus}}</span>\n      <div class=\"card-label\">MOISTURE CONTENT</div>\n      <div class=\"card-sub\">Humidity</div>\n      <div class=\"card-value\">{{msg.payload.bmeHum}}<span class=\"card-unit\">%</span></div>\n      <div class=\"progress-track\"><div class=\"progress-fill\" style=\"width: 55%; background: linear-gradient(90deg, #059669, #34d399);\"></div></div>\n      <div style=\"display:flex; justify-content:space-between; font-size:10px; color:#64748b; margin-top:4px;\"><span>0%</span><span>RELATIVE HUMIDITY</span><span>100%</span></div>\n    </div>\n\n    <div class=\"ei-card\">\n      <span class=\"status-tag\">{{msg.payload.sensorStatus}}</span>\n      <div class=\"card-label\">BAROMETRIC STATUS</div>\n      <div class=\"card-sub\">Atmospheric Pressure</div>\n      <div class=\"card-value\">{{msg.payload.bmePress}}<span class=\"card-unit\">hPa</span></div>\n      <div class=\"progress-track\"><div class=\"progress-fill\" style=\"width: 70%; background: linear-gradient(90deg, #7c3aed, #a78bfa);\"></div></div>\n      <div style=\"display:flex; justify-content:space-between; font-size:10px; color:#64748b; margin-top:4px;\"><span>950 hPa</span><span>BAROMETRIC PRESSURE</span><span>1050 hPa</span></div>\n    </div>\n  </div>\n\n  <div class=\"ei-footer-grid\">\n    <div class=\"ei-card\">\n      <div class=\"card-label\">EXTERNAL WEATHER</div>\n      <div class=\"card-sub\">OpenWeather Feed</div>\n      <div class=\"card-value\">{{msg.payload.weatherTemp}}<span class=\"card-unit\">&deg;C</span></div>\n      <div style=\"font-size:12px; color:#94a3b8; margin-top:8px;\">Outdoor Humidity: <b>{{msg.payload.weatherHum}}%</b></div>\n      <div style=\"font-size:11px; color:#64748b; margin-top:4px;\">Updated: {{msg.payload.weatherUpdated}}</div>\n    </div>\n\n    <div class=\"ei-card\">\n      <div class=\"card-label\">THERMAL GRADIENT ANALYSIS</div>\n      <div class=\"card-sub\">Classroom vs. Outdoor</div>\n      <div style=\"font-size:13px; color:#94a3b8; margin-bottom:6px;\">&bull; Classroom Indoor: <b style=\"color:#38bdf8;\">{{msg.payload.bmeTemp}} &deg;C</b></div>\n      <div style=\"font-size:13px; color:#94a3b8; margin-bottom:10px;\">&bull; Outdoor Weather: <b style=\"color:#f59e0b;\">{{msg.payload.weatherTemp}} &deg;C</b></div>\n      <div style=\"font-size:12px; color:#cbd5e1;\">Temp Difference: <b>{{msg.payload.tempDiff}}</b></div>\n      <div style=\"font-size:11px; color:#38bdf8; margin-top:4px;\">{{msg.payload.comparisonStatus}}</div>\n    </div>\n\n    <div class=\"advisory-box\">\n      <div class=\"advisory-title\">+ ENVIRONMENTAL ADVISORY &amp; COMFORT GUIDANCE</div>\n      <div class=\"advisory-text\">{{msg.payload.advisory}}</div>\n      <div style=\"margin-top:14px; font-size:11px; color:#64748b; display:flex; justify-content:space-between;\">\n        <span>SENSOR LINK: <b style=\"color:#38bdf8;\">{{msg.payload.sensorStatus}}</b></span>\n        <span>WEATHER FEED: <b style=\"color:#38bdf8;\">{{msg.payload.weatherStatus}}</b></span>\n      </div>\n    </div>\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 850,
    "y": 170,
    "wires": [
      []
    ]
  }
]