  {
    "id": "node_weather_response",
    "type": "function",
    "z": "tab_env_intel",
    "name": "Weather API Response",
    "func": "var res = msg.payload;\nif (res && res.main) {\n    flow.set('weather_temp', parseFloat(res.main.temp) || 0);\n    flow.set('weather_hum', parseFloat(res.main.humidity) || 0);\n    flow.set('weather_city', res.name || 'Chennai');\n    flow.set('weather_desc', res.weather && res.weather[0] ? res.weather[0].description : 'Clear');\n    flow.set('weather_updated', new Date().toLocaleTimeString());\n}\n\nmsg.payload = {\n    city: flow.get('weather_city'),\n    temp: flow.get('weather_temp'),\n    humidity: flow.get('weather_hum'),\n    description: flow.get('weather_desc'),\n    updated: flow.get('weather_updated')\n};\n\nreturn [msg, msg];",
    "outputs": 2,
    "x": 530,
    "y": 810,
    "wires": [
      [
        "node_refresh_dashboard"
      ],
      [
        "node_debug_weather"
      ]
    ]
  },
